# Demo API URL
DEMO_API_URL=http://localhost:4000

# Caller tokens (dev-only values - do not use in production)
ALICE_TOKEN=dev-alice-token
BILLING_TOKEN=dev-billing-token
AGENT_TOKEN=dev-agent-token

# Audit log HMAC key (local-development placeholder; replace with a random secret)
AUDIT_HMAC_KEY=dev-only-replace-with-a-random-32-byte-secret

# Optional: Anthropic API key for --enrich flag
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6
