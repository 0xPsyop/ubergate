{
  "name": "ubergate",
  "version": "0.1.0",
  "description": "OpenAPI-to-governed-MCP gateway with policy enforcement and audit logging",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ubergate": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/postbuild.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli/index.ts serve",
    "demo-api": "tsx examples/demo-api/server.ts",
    "crawl:demo": "tsx src/cli/index.ts crawl examples/demo-api/openapi.yaml --server demo --out config/tools.yaml",
    "validate": "tsx src/cli/index.ts validate",
    "bench": "tsx bench/compare.ts",
    "benchmark:tokens": "tsx scripts/benchmark-tokens.ts",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "openapi",
    "gateway",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "zod": "^3.25.0",
    "express": "^4.19.2",
    "@types/express": "^4.17.21",
    "yaml": "^2.5.0",
    "commander": "^12.1.0",
    "pino": "^9.3.0",
    "chokidar": "^4.0.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "@apidevtools/swagger-parser": "^10.0.3"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.32.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
